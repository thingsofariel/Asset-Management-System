# PostgreSQL connection (matches docker-compose.yml at repo root)
ASSET_DB_URL="postgresql://dev:dev@localhost:5432/asset_mgmt?schema=public"

# JWT
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="8h"

# Server
PORT=3001

# Local file storage
UPLOADS_DIR="./uploads"

# Seed script (initial Admin account — change password after first login)
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"
