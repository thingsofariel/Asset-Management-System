// ============================================================
// Unified Schema — Centralized Management System
// Modular Monolith: core / assets / helpdesk / payroll
//
// Baseline conventions (extending AMS's existing schema):
//   - UUID PKs for anything referenced across module boundaries
//     (core.User, core.Department)
//   - Domain-internal tables keep their original PK style where
//     nothing outside that module ever references them directly
//     (helpdesk stays Int/serial, payroll stays Int/autoincrement)
//   - Every field now gets an explicit @map to snake_case, fixing
//     the inconsistency where AMS's original schema left columns
//     as camelCase and Payslip's didn't
//   - Cross-module "soft references" (e.g. Notification -> Asset)
//     are plain scalar fields, not Prisma relations, so `core`
//     never has to import a domain module's models. Domain modules
//     may depend on core; core depends on nothing.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // single shared connection string now that there's one backend —
  // resolves the ASSET_DB_URL-vs-DATABASE_URL collision from the audit
}

// ============================================================
// CORE — identity, org structure, cross-module notifications
// ============================================================

enum Role {
  ADMIN
  EMPLOYEE
}

enum UserStatus {
  PENDING
  ACTIVE
  DISABLED
}

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  // Null until an invite is accepted — see the invite fields below.
  passwordHash String?     @map("password_hash")
  fullName     String      @map("full_name")
  avatarUrl    String?     @map("avatar_url") // carried over from Help Desk's admin_users
  role         Role        @default(EMPLOYEE)
  status       UserStatus  @default(ACTIVE) @map("status")

  department   Department? @relation(fields: [departmentId], references: [id])
  departmentId String?     @map("department_id")

  // Admin-invite flow: an admin creates a PENDING user with a token;
  // the invitee sets their own password to activate it. Token is
  // cleared once used or left to expire.
  inviteToken          String?   @unique @map("invite_token")
  inviteTokenExpiresAt DateTime? @map("invite_token_expires_at")
  invitedBy            User?     @relation("InvitedBy", fields: [invitedById], references: [id])
  invitedById          String?   @map("invited_by_id")
  invitedUsers         User[]    @relation("InvitedBy")

  // legacy reference fields — bridge for shadow-write migration,
  // dropped once all three modules read/write User exclusively
  legacyAmsUserId          String? @unique @map("legacy_ams_user_id")
  legacyHelpdeskAdminId    Int?    @unique @map("legacy_helpdesk_admin_id")
  legacyPayslipEmployeeId  Int?    @unique @map("legacy_payslip_employee_id")

  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  // --- assets module relations ---
  heldAssets         Asset[]           @relation("CurrentHolder")
  movementsFrom      AssetMovement[]   @relation("MovementFromUser")
  movementsTo        AssetMovement[]   @relation("MovementToUser")
  movementsProcessed AssetMovement[]   @relation("MovementProcessedBy")
  maintenanceLogs    MaintenanceLog[]  @relation("LoggedBy")
  attachments        AssetAttachment[] @relation("UploadedBy")
  auditsCreated      Audit[]           @relation("AuditCreatedBy")
  auditItemsScanned  AuditItem[]       @relation("ScannedBy")

  // --- payroll module relation ---
  employee           Employee?

  // --- core relations ---
  notifications      Notification[]    @relation("NotificationTarget")

  @@map("users")
}

model Department {
  id        String   @id @default(uuid())
  name      String
  users     User[]
  assets    Asset[]
  createdAt DateTime @default(now()) @map("created_at")

  @@map("departments")
}

model Notification {
  id       String  @id @default(uuid())
  target   User?   @relation("NotificationTarget", fields: [targetId], references: [id])
  targetId String? @map("target_id")

  title    String
  message  String

  // soft references — no enforced FK, kept loose on purpose (see header note)
  relatedAssetId   String? @map("related_asset_id")
  relatedRequestId Int?    @map("related_request_id")
  relatedPayslipId Int?    @map("related_payslip_id")

  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("notifications")
}

// ============================================================
// ASSETS module (ported ~as-is from AMS; User -> core.User)
// ============================================================

enum AssetType {
  FIXED
  ELECTRONIC
}

enum AssetStatus {
  GOOD
  REQUIRES_MAINTENANCE
  UNDER_REPAIR
  UNSERVICEABLE
  DISPOSED
}

enum MovementType {
  INBOUND
  OUTBOUND
  CHECKOUT
  CHECKIN
  TRANSFER
}

enum AttachmentType {
  PHOTO
  INVOICE
  OTHER
}

enum MatchStatus {
  MATCHED
  MISMATCH
  NOT_FOUND
}

model Location {
  id       String  @id @default(uuid())
  building String?
  floor    String?
  room     String

  assets             Asset[]
  movementsFrom      AssetMovement[] @relation("MovementFromLocation")
  movementsTo        AssetMovement[] @relation("MovementToLocation")
  auditItemsExpected AuditItem[]     @relation("ExpectedLocation")
  auditItemsScanned  AuditItem[]     @relation("ScannedLocation")

  @@map("locations")
}

model AssetCategory {
  id        String    @id @default(uuid())
  name      String
  assetType AssetType @map("asset_type")
  assets    Asset[]

  @@map("asset_categories")
}

model Asset {
  id              String        @id @default(uuid())
  assetCode       String        @unique @map("asset_code")
  name            String
  category        AssetCategory @relation(fields: [categoryId], references: [id])
  categoryId      String        @map("category_id")
  assetType       AssetType     @map("asset_type")
  brand           String?
  serialNumber    String?       @map("serial_number")
  specifications  Json?
  purchaseDate    DateTime?     @map("purchase_date")
  purchaseCost    Decimal?      @db.Decimal(12, 2) @map("purchase_cost")
  warrantyExpiry  DateTime?     @map("warranty_expiry")
  location        Location?     @relation(fields: [locationId], references: [id])
  locationId      String?       @map("location_id")
  department      Department?   @relation(fields: [departmentId], references: [id])
  departmentId    String?       @map("department_id")
  currentHolder   User?         @relation("CurrentHolder", fields: [currentHolderId], references: [id])
  currentHolderId String?       @map("current_holder_id")
  status          AssetStatus   @default(GOOD)
  qrImageUrl      String?       @map("qr_image_url")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  movements            AssetMovement[]
  maintenanceSchedules MaintenanceSchedule[]
  maintenanceLogs      MaintenanceLog[]
  attachments          AssetAttachment[]
  auditItems           AuditItem[]
  depreciation         DepreciationRecord?

  @@map("assets")
}

model AssetMovement {
  id             String        @id @default(uuid())
  asset          Asset         @relation(fields: [assetId], references: [id])
  assetId        String        @map("asset_id")
  movementType   MovementType  @map("movement_type")
  fromLocation   Location?     @relation("MovementFromLocation", fields: [fromLocationId], references: [id])
  fromLocationId String?       @map("from_location_id")
  toLocation     Location?     @relation("MovementToLocation", fields: [toLocationId], references: [id])
  toLocationId   String?       @map("to_location_id")
  fromUser       User?         @relation("MovementFromUser", fields: [fromUserId], references: [id])
  fromUserId     String?       @map("from_user_id")
  toUser         User?         @relation("MovementToUser", fields: [toUserId], references: [id])
  toUserId       String?       @map("to_user_id")
  processedBy    User?         @relation("MovementProcessedBy", fields: [processedById], references: [id])
  processedById  String?       @map("processed_by_id")
  movementDate   DateTime      @default(now()) @map("movement_date")
  notes          String?

  @@map("asset_movements")
}

model MaintenanceSchedule {
  id              String    @id @default(uuid())
  asset           Asset     @relation(fields: [assetId], references: [id])
  assetId         String    @map("asset_id")
  intervalMonths  Int       @map("interval_months")
  lastServiceDate DateTime? @map("last_service_date")
  nextDueDate     DateTime  @map("next_due_date")
  isActive        Boolean   @default(true) @map("is_active")

  logs MaintenanceLog[]

  @@map("maintenance_schedules")
}

model MaintenanceLog {
  id             String                @id @default(uuid())
  asset          Asset                 @relation(fields: [assetId], references: [id])
  assetId        String                @map("asset_id")
  schedule       MaintenanceSchedule?  @relation(fields: [scheduleId], references: [id])
  scheduleId     String?               @map("schedule_id")
  serviceDate    DateTime              @map("service_date")
  vendorName     String?               @map("vendor_name")
  technicianName String?               @map("technician_name")
  partsReplaced  String?               @map("parts_replaced")
  cost           Decimal?              @db.Decimal(12, 2)
  notes          String?
  loggedBy       User?                 @relation("LoggedBy", fields: [loggedById], references: [id])
  loggedById     String?               @map("logged_by_id")
  createdAt      DateTime              @default(now()) @map("created_at")

  @@map("maintenance_logs")
}

model AssetAttachment {
  id           String         @id @default(uuid())
  asset        Asset          @relation(fields: [assetId], references: [id])
  assetId      String         @map("asset_id")
  fileUrl      String         @map("file_url")
  fileType     AttachmentType @map("file_type")
  uploadedBy   User?          @relation("UploadedBy", fields: [uploadedById], references: [id])
  uploadedById String?        @map("uploaded_by_id")
  notes        String?
  createdAt    DateTime       @default(now()) @map("created_at")

  @@map("asset_attachments")
}

model Audit {
  id          String    @id @default(uuid())
  name        String
  startDate   DateTime? @map("start_date")
  endDate     DateTime? @map("end_date")
  status      String    @default("IN_PROGRESS")
  createdBy   User?     @relation("AuditCreatedBy", fields: [createdById], references: [id])
  createdById String?   @map("created_by_id")

  items AuditItem[]

  @@map("audits")
}

model AuditItem {
  id                 String       @id @default(uuid())
  audit              Audit        @relation(fields: [auditId], references: [id])
  auditId            String       @map("audit_id")
  asset              Asset        @relation(fields: [assetId], references: [id])
  assetId            String       @map("asset_id")
  expectedLocation   Location?    @relation("ExpectedLocation", fields: [expectedLocationId], references: [id])
  expectedLocationId String?      @map("expected_location_id")
  scannedLocation    Location?    @relation("ScannedLocation", fields: [scannedLocationId], references: [id])
  scannedLocationId  String?      @map("scanned_location_id")
  scannedAt          DateTime?    @map("scanned_at")
  scannedBy          User?        @relation("ScannedBy", fields: [scannedById], references: [id])
  scannedById        String?      @map("scanned_by_id")
  conditionStatus    AssetStatus? @map("condition_status")
  matchStatus        MatchStatus? @map("match_status")
  notes              String?

  @@map("audit_items")
}

model DepreciationRecord {
  id                 String    @id @default(uuid())
  asset              Asset     @relation(fields: [assetId], references: [id])
  assetId            String    @unique @map("asset_id")
  method             String    @default("STRAIGHT_LINE")
  usefulLifeYears    Int?      @map("useful_life_years")
  salvageValue       Decimal?  @db.Decimal(12, 2) @map("salvage_value")
  annualDepreciation Decimal?  @db.Decimal(12, 2) @map("annual_depreciation")
  bookValue          Decimal?  @db.Decimal(12, 2) @map("book_value")
  asOfDate           DateTime? @map("as_of_date")

  @@map("depreciation_records")
}

// ============================================================
// HELPDESK module (ported off raw SQL; admin_users dropped —
// folded into core.User with role = ADMIN. Everything else here
// stays domain-internal, so PKs stay Int/serial as before.)
// ============================================================

enum RequestStatus {
  OPEN
  ACCEPTED
  DENIED
  IN_PROGRESS
  DONE
  CLOSED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

model Category {
  id              Int      @id @default(autoincrement())
  name            String
  parent          Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  parentId        Int?     @map("parent_id")
  children        Category[] @relation("CategoryTree")
  defaultPriority Priority @default(MEDIUM) @map("default_priority")

  requests Request[]

  @@map("categories")
}

model Request {
  id       Int    @id @default(autoincrement())
  publicCode String @unique @map("public_code") // e.g. "REQ-7X3F9K2Q"

  fullName String @map("full_name")
  email    String
  phone    String

  category           Category? @relation(fields: [categoryId], references: [id])
  categoryId         Int?      @map("category_id")
  customCategoryText String?   @map("custom_category_text")

  description   String
  attachmentUrl String?        @map("attachment_url")

  status       RequestStatus @default(OPEN)
  priority     Priority      @default(MEDIUM)
  denialReason String?       @map("denial_reason")

  acceptedAt  DateTime? @map("accepted_at")
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  closedAt    DateTime? @map("closed_at")

  createdAt DateTime @default(now()) @map("created_at")

  review       RequestReview?
  activityLog  RequestActivityLog[]

  @@index([status, priority, createdAt])
  @@index([publicCode])
  @@map("requests")
}

model RequestReview {
  id        Int      @id @default(autoincrement())
  request   Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId Int      @unique @map("request_id")
  rating    Int
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("request_reviews")
}

model RequestActivityLog {
  id         Int      @id @default(autoincrement())
  request    Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId  Int      @map("request_id")
  fromStatus String?  @map("from_status")
  toStatus   String   @map("to_status")
  note       String?
  changedAt  DateTime @default(now()) @map("changed_at")

  @@map("request_activity_log")
}

// ============================================================
// PAYROLL module (ported off Payslip's Prisma 7 schema onto this
// shared Prisma client. Employee keeps its own Int PK — everything
// downstream (Payslip, EarningDetail, etc.) still references it the
// same way — but now links out to core.User via userId for auth,
// instead of being the auth table itself.)
// ============================================================

enum EmploymentStatus {
  PERMANENT
  CONTRACT
  FREELANCE
  INTERN
}

enum PayslipStatus {
  DRAFT
  FINALIZED
  SENT
  ARCHIVED
}

enum EarningCategory {
  ALLOWANCE
  BONUS
  OVERTIME
  INCENTIVE
  OTHER
}

enum DeductionCategory {
  BPJS_HEALTH
  BPJS_PENSION
  PPH21_TAX
  ABSENCE_PENALTY
  SALARY_ADVANCE
  OTHER
}

model Employee {
  employeeId Int @id @default(autoincrement()) @map("employee_id")

  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId String @unique @map("user_id")

  jobTitle         String           @map("job_title")
  employmentStatus EmploymentStatus @default(PERMANENT) @map("employment_status")
  bankAccountNo    String           @map("bank_account_no")

  // sensitive — encrypt at the application layer before persisting
  // (see original Payslip README security note)
  nik         String?   @unique
  dateOfBirth DateTime? @map("date_of_birth") @db.Date

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  payslips  Payslip[]
  auditLogs PayrollAuditLog[] @relation("ActorPayrollAuditLogs")

  @@map("employees")
}

model Payslip {
  payslipId Int @id @default(autoincrement()) @map("payslip_id")

  employeeId Int      @map("employee_id")
  employee   Employee @relation(fields: [employeeId], references: [employeeId], onDelete: Restrict)

  periodMonth Int @map("period_month")
  periodYear  Int @map("period_year")

  issueDate     DateTime @map("issue_date") @db.Date
  issueLocation String   @default("Kupang") @map("issue_location")

  basicSalary Decimal @default(0) @map("basic_salary") @db.Decimal(14, 2)

  totalEarnings   Decimal @default(0) @map("total_earnings") @db.Decimal(14, 2)
  totalDeductions Decimal @default(0) @map("total_deductions") @db.Decimal(14, 2)
  netPay          Decimal @default(0) @map("net_pay") @db.Decimal(14, 2)

  authorizedSignatory String @map("authorized_signatory")

  status PayslipStatus @default(DRAFT)

  verificationHash String? @map("verification_hash")
  pdfPath          String? @map("pdf_path")
  pdfGeneratedAt   DateTime? @map("pdf_generated_at")
  shareToken       String?   @unique @map("share_token")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  earningDetails   EarningDetail[]
  deductionDetails DeductionDetail[]
  auditLogs        PayrollAuditLog[]

  @@unique([employeeId, periodMonth, periodYear], name: "uniq_employee_period")
  @@index([employeeId, periodYear, periodMonth])
  @@index([status])
  @@map("payslips")
}

model EarningDetail {
  earningId Int @id @default(autoincrement()) @map("earning_id")

  payslipId Int     @map("payslip_id")
  payslip   Payslip @relation(fields: [payslipId], references: [payslipId], onDelete: Cascade)

  label    String
  category EarningCategory @default(ALLOWANCE)

  amount    Decimal @db.Decimal(14, 2)
  sortOrder Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([payslipId])
  @@map("earning_details")
}

model DeductionDetail {
  deductionId Int @id @default(autoincrement()) @map("deduction_id")

  payslipId Int     @map("payslip_id")
  payslip   Payslip @relation(fields: [payslipId], references: [payslipId], onDelete: Cascade)

  label    String
  category DeductionCategory @default(OTHER)

  amount    Decimal @db.Decimal(14, 2)
  sortOrder Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([payslipId])
  @@map("deduction_details")
}

// Renamed from Payslip's original "AuditLog" — AMS already uses
// Audit/AuditItem for physical stocktake audits, so this stays
// PayrollAuditLog to avoid two unrelated concepts sharing one name.
model PayrollAuditLog {
  logId Int @id @default(autoincrement()) @map("log_id")

  payslipId Int?     @map("payslip_id")
  payslip   Payslip? @relation(fields: [payslipId], references: [payslipId], onDelete: SetNull)

  actorId Int      @map("actor_id")
  actor   Employee @relation("ActorPayrollAuditLogs", fields: [actorId], references: [employeeId])

  action String
  detail String?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([payslipId])
  @@index([actorId])
  @@map("payroll_audit_logs")
}
